# =============================================================================
#  Syncra HIMS — environment template
#  Create your local .env with:   ./scripts/init-env.sh
#  (every value marked __GENERATE__ is replaced with a random 256-bit secret)
#  Secrets must stay URL-safe (hex/alphanumeric) — they are embedded in URIs/JSON.
# =============================================================================

# ---- General -----------------------------------------------------------------
TZ=Asia/Kolkata
SYNCRA_VERSION=0.1.0
# development | staging | production
SYNCRA_ENVIRONMENT=development

# ---- PostgreSQL 16 -----------------------------------------------------------
POSTGRES_DB=syncra_hims
# Superuser: owns the schema, used only for migrations/administration
POSTGRES_USER=syncra_admin
POSTGRES_PASSWORD=__GENERATE__
# Least-privilege role (DML only) that application services connect as
SYNCRA_APP_DB_USER=syncra_app
SYNCRA_APP_DB_PASSWORD=__GENERATE__
# Role owning the isolated `orthanc` database (PACS index)
ORTHANC_DB_PASSWORD=__GENERATE__

# ---- Redis -------------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__

# ---- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=syncra
RABBITMQ_PASSWORD=__GENERATE__
RABBITMQ_VHOST=syncra

# ---- Orthanc PACS ------------------------------------------------------------
ORTHANC_USERNAME=syncra_pacs
ORTHANC_PASSWORD=__GENERATE__
# DICOM Application Entity title (max 16 chars) configured on CT/MRI/CR modalities
ORTHANC_AET=SYNCRAPACS
# Interface modalities send C-STORE to. Restrict to the imaging VLAN IP in production.
ORTHANC_DICOM_BIND=0.0.0.0
ORTHANC_DICOM_PORT=4242
# Named volume (default) or absolute host path to the imaging RAID, e.g. /srv/syncra/dicom
ORTHANC_STORAGE=orthanc-storage

# ---- API Gateway / security --------------------------------------------------
GATEWAY_BIND=0.0.0.0
GATEWAY_HOST_PORT=8080
# HS256 signing secret shared with the (upcoming) IAM service; >= 32 bytes
SYNCRA_JWT_SECRET=__GENERATE__
SYNCRA_JWT_ISSUER=https://auth.syncra.local
SYNCRA_JWT_AUDIENCE=syncra-hims
# Comma-separated browser origins of the Doctor Desk / front-office UI
SYNCRA_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ---- Billing ------------------------------------------------------------------
# Letterhead printed on bills (GSTIN is required if any service is taxable)
SYNCRA_HOSPITAL_NAME=Syncra Hospital
SYNCRA_HOSPITAL_ADDRESS=
SYNCRA_HOSPITAL_PHONE=
SYNCRA_HOSPITAL_GSTIN=
# A paid registration covers OPD visits for this many days
SYNCRA_BILLING_REGISTRATION_VALIDITY_DAYS=365

# ---- Clinical decision support -------------------------------------------------
# true = prescriptions cannot be signed while the CDSS is unreachable (default: sign and audit the gap)
SYNCRA_CDSS_REQUIRED=false
# Path (inside the ai-service container) of a hospital-reviewed CDSS knowledge base; empty = bundled starter set
SYNCRA_AI_CDSS_KNOWLEDGE_PATH=

# ---- ABDM (Ayushman Bharat Digital Mission) ---------------------------------
# Off until the hospital has ABDM credentials (sandbox first: https://sandbox.abdm.gov.in).
SYNCRA_ABDM_ENABLED=false
# sbx = sandbox consent manager, abdm = production
SYNCRA_ABDM_CM_ID=sbx
# Health Facility Registry (HFR) id of this hospital; it is the HIP id
SYNCRA_ABDM_HIP_ID=
SYNCRA_ABDM_CLIENT_ID=
SYNCRA_ABDM_CLIENT_SECRET=
# Sandbox endpoints; production: https://apis.abdm.gov.in/api/hiecm and https://abha.abdm.gov.in/abha/api
SYNCRA_ABDM_GATEWAY_URL=https://dev.abdm.gov.in/api/hiecm
SYNCRA_ABDM_ABHA_URL=https://abhasbx.abdm.gov.in/abha/api
# ABDM's callback signing keys; empty = <gateway>/gateway/v3/certs. Optional required token issuer.
SYNCRA_ABDM_JWKS_URI=
SYNCRA_ABDM_TOKEN_ISSUER=
# Send this HIP's gateway session token when pushing to an HIU (only if ABDM requires it)
SYNCRA_ABDM_PUSH_SEND_SESSION_TOKEN=false
# HIU (viewing records from other hospitals): public HTTPS URL of this ABDM bridge, which
# other hospitals push consented records to. Empty = no records are requested.
SYNCRA_ABDM_PUBLIC_URL=
# Namespace for this hospital's identifiers inside FHIR records (use the hospital's own domain)
SYNCRA_FHIR_IDENTIFIER_SYSTEM=https://hims.syncra.local/fhir/identifier
# SMS provider for the OTP patients confirm when linking records from their PHR app.
# The service POSTs {to, message, senderId, templateId, variables:{otp,hospital,minutes}} as JSON
# with <AUTH_HEADER>: <AUTH_VALUE>. Sender id and template must be DLT-registered (TRAI).
# Leave SYNCRA_SMS_URL empty to switch patient-initiated linking off (ABDM is told why).
SYNCRA_SMS_URL=
SYNCRA_SMS_AUTH_HEADER=Authorization
SYNCRA_SMS_AUTH_VALUE=
SYNCRA_SMS_SENDER_ID=
SYNCRA_SMS_TEMPLATE_ID=

# ---- Doctor Desk (web) ------------------------------------------------------
WEB_BIND=0.0.0.0
WEB_HOST_PORT=3000

# ---- AI service --------------------------------------------------------------
SYNCRA_AI_LOG_LEVEL=INFO
# whisper (on-premises speech-to-text) | none
SYNCRA_AI_STT_ENGINE=whisper
# base (fastest) | small (default; good Indian-English + Hindi) | medium (most accurate, ~3x slower)
SYNCRA_AI_WHISPER_MODEL=small
SYNCRA_AI_WHISPER_CPU_THREADS=4

# ---- Dev-only loopback ports (docker-compose.override.yml) --------------------
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
ORTHANC_HTTP_HOST_PORT=8042
AI_SERVICE_HOST_PORT=8000

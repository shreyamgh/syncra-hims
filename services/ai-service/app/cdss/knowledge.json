  "interactions": [
    {"code": "DDI-VKA-NSAID", "a": ["class:vka"], "b": ["class:nsaid"], "severity": "MAJOR",
     "effect": "Increased risk of bleeding (oral anticoagulant with an NSAID or aspirin).",
     "management": "Avoid; prefer paracetamol for pain. If unavoidable, add gastroprotection and monitor INR and bleeding.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-VKA-METRONIDAZOLE", "a": ["class:vka"], "b": ["metronidazole"], "severity": "MAJOR",
     "effect": "Metronidazole markedly increases the anticoagulant effect (INR rise, bleeding).",
     "management": "Avoid, or reduce the anticoagulant dose and check INR within 3-5 days.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-VKA-AZOLE", "a": ["class:vka"], "b": ["class:azole_antifungal"], "severity": "MAJOR",
     "effect": "Azole antifungals increase the anticoagulant effect (INR rise, bleeding).",
     "management": "Monitor INR closely and adjust the dose.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-VKA-COTRIMOXAZOLE", "a": ["class:vka"], "b": ["cotrimoxazole"], "severity": "MAJOR",
     "effect": "Co-trimoxazole increases the anticoagulant effect (INR rise, bleeding).",
     "management": "Prefer another antibiotic; otherwise monitor INR closely.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-VKA-MACROLIDE", "a": ["class:vka"], "b": ["clarithromycin", "erythromycin"], "severity": "MODERATE",
     "effect": "Clarithromycin and erythromycin can increase the anticoagulant effect.",
     "management": "Monitor INR during and after the course.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-VKA-RIFAMPICIN", "a": ["class:vka"], "b": ["rifampicin"], "severity": "MAJOR",
     "effect": "Rifampicin markedly reduces the anticoagulant effect.",
     "management": "Expect large dose increases; monitor INR closely, including after stopping rifampicin.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-VKA-CLOPIDOGREL", "a": ["class:vka"], "b": ["clopidogrel"], "severity": "MAJOR",
     "effect": "Increased risk of bleeding (anticoagulant with an antiplatelet).",
     "management": "Combine only when specifically indicated; review duration and bleeding risk.", "source": "BNF"},
    {"code": "DDI-LMWH-NSAID", "a": ["class:lmwh"], "b": ["class:nsaid"], "severity": "MAJOR",
     "effect": "Increased risk of bleeding (heparin with an NSAID or aspirin).",
     "management": "Avoid unless specifically indicated; monitor for bleeding.", "source": "BNF"},
    {"code": "DDI-CLOPIDOGREL-PPI", "a": ["clopidogrel"], "b": ["omeprazole", "esomeprazole"], "severity": "MODERATE",
     "effect": "Omeprazole and esomeprazole reduce the antiplatelet effect of clopidogrel.",
     "management": "Use pantoprazole if a PPI is needed.", "source": "EMA; FDA; BNF"},
    {"code": "DDI-SIMVASTATIN-CYP3A4", "a": ["simvastatin"],
     "b": ["clarithromycin", "erythromycin", "ketoconazole", "itraconazole"], "severity": "CONTRAINDICATED",
     "effect": "Large rise in simvastatin levels: risk of myopathy and rhabdomyolysis.",
     "management": "Do not combine; withhold simvastatin during the course or choose another antibiotic.",
     "source": "FDA; BNF"},
    {"code": "DDI-ATORVASTATIN-CYP3A4", "a": ["atorvastatin"], "b": ["clarithromycin", "ketoconazole", "itraconazole"],
     "severity": "MAJOR", "effect": "Raised atorvastatin levels: risk of myopathy.",
     "management": "Avoid, or limit atorvastatin dose and monitor for muscle symptoms.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-SIMVASTATIN-AMLODIPINE", "a": ["simvastatin"], "b": ["amlodipine"], "severity": "MODERATE",
     "effect": "Amlodipine raises simvastatin levels.", "management": "Do not exceed simvastatin 20 mg daily.",
     "source": "FDA; BNF"},
    {"code": "DDI-PDE5-NITRATE", "a": ["class:pde5_inhibitor"], "b": ["class:nitrate"], "severity": "CONTRAINDICATED",
     "effect": "Profound, potentially fatal hypotension.", "management": "Never combine.", "source": "BNF; FDA"},
    {"code": "DDI-RAAS-POTASSIUM", "a": ["class:ace_inhibitor", "class:arb"],
     "b": ["class:potassium_sparing_diuretic", "class:potassium_supplement"], "severity": "MAJOR",
     "effect": "Risk of severe hyperkalaemia.", "management": "Monitor potassium and renal function closely.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-ACE-ARB", "a": ["class:ace_inhibitor"], "b": ["class:arb"], "severity": "MAJOR",
     "effect": "Dual renin-angiotensin blockade: hyperkalaemia, hypotension and acute kidney injury.",
     "management": "Avoid the combination.", "source": "EMA; BNF"},
    {"code": "DDI-RAAS-NSAID", "a": ["class:ace_inhibitor", "class:arb"], "b": ["class:nsaid"], "severity": "MODERATE",
     "effect": "Reduced antihypertensive effect and risk of acute kidney injury, especially with a diuretic.",
     "management": "Avoid regular NSAID use; monitor renal function and blood pressure.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-METHOTREXATE-COTRIMOXAZOLE", "a": ["methotrexate"], "b": ["cotrimoxazole"], "severity": "MAJOR",
     "effect": "Severe bone-marrow suppression (additive antifolate effect).", "management": "Avoid.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-METHOTREXATE-NSAID", "a": ["methotrexate"], "b": ["class:nsaid"], "severity": "MODERATE",
     "effect": "NSAIDs reduce methotrexate excretion: risk of toxicity.",
     "management": "Use with caution and monitor blood counts and renal function.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-LITHIUM-NSAID", "a": ["lithium"], "b": ["class:nsaid"], "severity": "MAJOR",
     "effect": "NSAIDs raise lithium levels: risk of toxicity.", "management": "Avoid, or monitor lithium levels closely.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-LITHIUM-RAAS", "a": ["lithium"], "b": ["class:ace_inhibitor", "class:arb"], "severity": "MAJOR",
     "effect": "ACE inhibitors and ARBs raise lithium levels: risk of toxicity.", "management": "Monitor lithium levels closely.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-LITHIUM-THIAZIDE", "a": ["lithium"], "b": ["class:thiazide"], "severity": "MAJOR",
     "effect": "Thiazides raise lithium levels: risk of toxicity.", "management": "Avoid, or monitor lithium levels closely.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-TRAMADOL-SSRI", "a": ["tramadol"], "b": ["class:ssri"], "severity": "MAJOR",
     "effect": "Risk of serotonin syndrome and seizures.", "management": "Avoid, or use the lowest dose with close monitoring.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-LINEZOLID-SEROTONERGIC", "a": ["linezolid"], "b": ["class:ssri", "tramadol"], "severity": "MAJOR",
     "effect": "Linezolid is a reversible MAO inhibitor: risk of serotonin syndrome.",
     "management": "Avoid; if essential, monitor closely for serotonin toxicity.", "source": "FDA; BNF"},
    {"code": "DDI-BENZODIAZEPINE-OPIOID", "a": ["class:benzodiazepine"], "b": ["class:opioid"], "severity": "MAJOR",
     "effect": "Additive sedation and respiratory depression.", "management": "Avoid, or use the lowest doses for the shortest time.",
     "source": "FDA"},
    {"code": "DDI-DIGOXIN-AMIODARONE", "a": ["digoxin"], "b": ["amiodarone"], "severity": "MAJOR",
     "effect": "Amiodarone raises digoxin levels: risk of toxicity.", "management": "Halve the digoxin dose and monitor levels.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-DIGOXIN-CLARITHROMYCIN", "a": ["digoxin"], "b": ["clarithromycin"], "severity": "MAJOR",
     "effect": "Clarithromycin raises digoxin levels: risk of toxicity.", "management": "Monitor digoxin levels or choose another antibiotic.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-THEOPHYLLINE-CIPROFLOXACIN", "a": ["theophylline"], "b": ["ciprofloxacin"], "severity": "MAJOR",
     "effect": "Ciprofloxacin raises theophylline levels: risk of seizures and arrhythmia.",
     "management": "Avoid, or reduce the theophylline dose and monitor levels.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-QUINOLONE-CATION", "a": ["class:fluoroquinolone"], "b": ["class:antacid", "class:iron", "class:calcium"],
     "severity": "MODERATE", "effect": "Antacids, iron and calcium reduce fluoroquinolone absorption.",
     "management": "Give the fluoroquinolone at least 2 hours before or 6 hours after.", "source": "BNF; STOCKLEY"},
    {"code": "DDI-ALLOPURINOL-AZATHIOPRINE", "a": ["allopurinol"], "b": ["azathioprine"], "severity": "MAJOR",
     "effect": "Allopurinol blocks azathioprine metabolism: severe bone-marrow suppression.",
     "management": "Avoid, or reduce azathioprine to a quarter of the dose with close blood-count monitoring.",
     "source": "BNF; STOCKLEY"},
    {"code": "DDI-RIFAMPICIN-CONTRACEPTIVE", "a": ["rifampicin"], "b": ["class:hormonal_contraceptive"], "severity": "MAJOR",
     "effect": "Rifampicin reduces contraceptive effectiveness.", "management": "Use a non-hormonal method during and for 4 weeks after.",
     "source": "BNF"},
    {"code": "DDI-DOMPERIDONE-CYP3A4", "a": ["domperidone"], "b": ["class:strong_cyp3a4_inhibitor"],
     "severity": "CONTRAINDICATED", "effect": "Raised domperidone levels and QT prolongation: risk of arrhythmia.",
     "management": "Do not combine.", "source": "EMA"},
    {"code": "DDI-SULFONYLUREA-FLUCONAZOLE", "a": ["class:sulfonylurea"], "b": ["fluconazole"], "severity": "MODERATE",
     "effect": "Fluconazole raises sulfonylurea levels: risk of hypoglycaemia.", "management": "Monitor blood glucose.",
     "source": "BNF; STOCKLEY"}
  ],
